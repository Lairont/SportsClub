@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@model SportClub_Bancu.Domain.ModelsDb.UserDb

@{
    Layout = "_Layout";
    ViewData["Title"] = "Профиль";

    // Данные берем из Claims (из сессии)
    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? "Без имени";
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? "Email не указан";
    var avatar = User.FindFirst("local_pic")?.Value;
    if (string.IsNullOrEmpty(avatar)) avatar = "/images/default-avatar.png";
}

<style>
    .img-header {
        display: none;
    }

    .profile-field small {
        color: #6c757d;
        display: block;
        margin-top: 5px;
    }

    .save-profile-btn {
        margin-top: 20px;
        cursor: pointer;
    }
</style>

<section class="profile-section">
    <form asp-action="UpdateProfile" asp-controller="Home" method="post" enctype="multipart/form-data" class="profile-card">

        <div class="profile-avatar">
            <img id="avatar-preview" src="@avatar" alt="Аватар пользователя" />

            <label for="avatar-input" class="change-avatar-btn" style="cursor:pointer; display: inline-block; text-align: center;">
                Изменить аватар
            </label>
            <input type="file" id="avatar-input" name="avatarFile" style="display:none;" accept="image/*" onchange="previewImage(this)" />
        </div>

        <div class="profile-info">
            <div class="profile-field">
                <label>Имя (Логин)</label>
                <input type="text" name="userName" value="@userName" required />
            </div>

            <div class="profile-field">
                <label>Email</label>
                <input type="email" value="@email" disabled style="background: #eee;" />
            </div>

            <button type="submit" class="save-profile-btn">Сохранить изменения</button>
        </div>
    </form>
</section>

<script>
    // Предпросмотр выбранного изображения
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('avatar-preview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>




