@*сообщение*@
<style>
    .container-section {
        width: 30%; 
        min-width: 1000px; 
        margin: 50px auto;
        background-color: #ffffff;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        border: 1px solid rgba(0,0,0,0.02);
        box-sizing: border-box; 
    }
</style>

<div class="container-section">
    <h2>Написать сообщение</h2>

    <form action="https://formsubmit.co/petrbancu@gmail.com" method="POST">
        <div class="message-text">
            <label for="name">Ваше имя:</label>
            <input type="text" id="name" name="name" class="text text-short" placeholder="Введите ваше имя" required>
        </div>

        <div class="message-text">
            <label for="email">Ваш E-mail:</label>
            <input type="email" id="email" name="_replyto" class="text text-short" placeholder="example@mail.com" required>
        </div>

        <div class="message-text">
            <label for="message">Сообщение:</label>
            <textarea id="message" name="message" class="text" placeholder="Введите ваше сообщение..." required></textarea>
        </div>

        <input type="hidden" name="_captcha" value="false">

        <div class="message-button">
            <button class="button" type="submit">Отправить</button>
        </div>
    </form>
</div>

<footer>
    <div class="footer-left">
        <h2>FitStock</h2>
        <p>
            Наша система помогает спортивным клубам и секциям эффективно управлять инвентарём и оборудованием.
            Вы сможете легко отслеживать состояние, местоположение и использование всех спортивных принадлежностей,
            планировать выдачу и возврат, а также оптимизировать закупки, экономя время и ресурсы клуба.
        </p>
        <div class="footer-TravelAgency">
            &copy; 2025 FitStock Bancu
        </div>
    </div>

    <div class="contact-grid">

        <!-- 1. Email -->
        <a href="mailto:TTiP@mail.ru" class="contact-card">
 
            <img class="card-icon" src="~/images/email.png" alt="Email Icon" />
            <h2>Email</h2>
            <p>TTiP@mail.ru</p>
        </a>

        <!-- 2. Телефон -->
        <a href="tel:+37377777777" class="contact-card">
            <img class="card-icon" src="~/images/telefon.png" alt="Phone Icon" />
            <h2>Телефон</h2>
            <p>+ (373) 777-77-777</p>
        </a>

        <!-- 3. Адрес -->
        <div class="contact-card">
            <img class="card-icon" src="~/images/mesto.png" alt="Address Icon" />
            <h2>Адрес</h2>
            <p>Тираспольский техникум информатики и права</p>
        </div>
    </div>

    <!-- НОВЫЙ БЛОК: Социальные сети -->
