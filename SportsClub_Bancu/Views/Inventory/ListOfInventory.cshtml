@model SportClub_Bancu.Domain.ViewModels.InventoryListViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Список инвентаря";
}
<style>
    .img-header {
        display: none;
    }


    body {
        background: linear-gradient(135deg, #fff9f0 0%, #fdf6ed 100%);
        color: #2e2e2e;
        padding-top: 80px;
        display: flex;
        flex-direction: column;
        align-items: normal;

    }
</style>
<div class="sc-inv-container">

    <div class="sc-inv-link-page">
        <a href="/Home/SiteInformation">Главная</a> > Инвентарь
    </div>



    <div class="inventory-wrapper">

        <div class="filter-sidebar">
            <div class="filter">
                <h3>Фильтр</h3>

                <div class="price-filter">
                    <label class="title">Цена инвентаря:</label>

                    <span id="min-label">0</span>
                    <label>Минимальная цена:</label>
                    <input type="range" id="min-price" min="0" max="500000" value="0">

                    <label>Максимальная цена:</label>
                    <input type="range" id="max-price" min="0" max="500000" value="500000">
                    <span id="max-label">500000</span>

                    <div>Текущие значения: <span id="price-values">0 - 500000</span></div>
                </div>



                <div class="category-filter">
                    <div class="filter">
                        <div class="category-filter">
                            <label class="title">Категории:</label>

                            <div class="category-options">
                                @if (Model.AvailableCategories != null)
                                {
                                    int i = 0;

                                     @foreach (var category in Model.AvailableCategories)
                                    {
                                        i++;
                                        <input type="checkbox"
                                               id="cat-@i"
                                               value="@category.Id"
                                               class="btn-checkbox category-checkbox">
                                        <label for="cat-@i">@category.Name</label>
                                    }
                                }
                                else
                                {
                                    <p>Категории не загружены. Проверьте Controller.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>




                <div class="filter-button">
                    <button id="apply-filter">Применить фильтр</button>
                </div>
            </div>
        </div> @* Конец filter-sidebar *@


        @* ПРАВАЯ КОЛОНКА: СОРТИРОВКА + ТОВАРЫ *@
        <div class="products-content">

            <div class="sorts">
                <label for="sort-options">Сортировать по:</label>
                <select id="sort-options">
                    <option value="default">Выберите...</option>
                    <option value="price-asc">Цена (по возрастанию)</option>
                    <option value="price-desc">Цена (по убыванию)</option>
                    <option value="count-asc">Количество (по возрастанию)</option>
                    <option value="count-desc">Количество (по убыванию)</option>
                </select>
            </div>

            <div class="sc-inv-grid-container">
                @if (Model != null && Model.InventoryItems.Count != 0)
                {
                    foreach (var item in Model.InventoryItems)
                    {
                        <a href="/Inventory/Details/@item.Id" class="sc-inv-card inventory-item">

                            <img src="@item.PathImg" alt="@item.Name" class="sc-inv-card-image" />

                            <div class="sc-inv-card-overlay">
                                <div class="sc-inv-card-title">@item.Name</div>

                                <p class="sc-inv-card-description">
                                    Количество в наличии: <span class="item-count">@item.Count</span> <br />
                                    Цена: <span class="item-price">@item.Price ₽</span>
                                </p>
                            </div>
                        </a>

                    }
                }

                else
                {
                    <p>В настоящее время инвентарь не найден.</p>
                }
            </div>
        </div> @* Конец products-content *@
    </div> @* Конец inventory-wrapper *@
</div>