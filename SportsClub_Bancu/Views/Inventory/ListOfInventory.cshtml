@model SportClub_Bancu.Domain.ViewModels.InventoryListViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Список инвентаря";
}
<style>
    .img-header {
        display: none;
    }


    body {
        background: linear-gradient(135deg, #fff9f0 0%, #fdf6ed 100%);
        color: #2e2e2e;
        padding-top: 80px;
        display: flex;
        flex-direction: column;
        align-items: normal;

    }
</style>


<div class="search">
    <div class="input">
        <input type="text" id="mySearch" placeholder="Поиск" />
    </div>
</div>

<div class="sc-inv-container">

    <div class="sc-inv-link-page">
        <a href="/Home/SiteInformation">Главная</a> > Инвентарь
    </div>



    <div class="inventory-wrapper">

        <div class="filter-sidebar">
            <div class="filter">
                <h3>Фильтр</h3>

                <div class="price-filter">
                    <label class="title">Цена инвентаря:</label>

                    <span id="min-label">0</span>
                    <label>Минимальная цена:</label>
                    <input type="range" id="min-price" min="0" max="200000" value="0">

                    <label>Максимальная цена:</label>
                    <input type="range" id="max-price" min="0" max="200000" value="200000">
                    <span id="max-label">200000</span>

                    <div>Текущие значения: <span id="price-values">0 - 200000</span></div>
                </div>



                <div class="category-filter">
                    <div class="filter">
                        <div class="category-filter">
                            <label class="title">Категории:</label>

                            <div class="category-options">
                                @if (Model.AvailableCategories != null)
                                {
                                    int i = 0;

                                     @foreach (var category in Model.AvailableCategories)
                                    {
                                        i++;
                                        <input type="checkbox"
                                               id="cat-@i"
                                               value="@category.Id"
                                               class="btn-checkbox category-checkbox">
                                        <label for="cat-@i">@category.Name</label>
                                    }
                                }
                                else
                                {
                                    <p>Категории не загружены. Проверьте Controller.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>




                <div class="filter-button">
                    <button id="apply-filter">Применить фильтр</button>
                </div>
            </div>
        </div> 


  
        <div class="products-content">

            <div class="sorts">
                <label for="sort-options">Сортировать по:</label>
                <select id="sort-options">
                    <option value="default">Выберите...</option>
                    <option value="price-asc">Цена (по возрастанию)</option>
                    <option value="price-desc">Цена (по убыванию)</option>
                    <option value="count-asc">Количество (по возрастанию)</option>
                    <option value="count-desc">Количество (по убыванию)</option>
                </select>
            </div>

            <div class="sc-inv-grid-container">
                @if (Model != null && Model.InventoryItems.Count != 0)
                {
                    foreach (var item in Model.InventoryItems)
                    {
                        <a href="@Url.Action("PageOfInventory", "Inventory", new { Id = item.Id })" class="sc-inv-card inventory-item">

                            <img src="@item.PathImg" alt="@item.Name" class="sc-inv-card-image" />

                            <div class="sc-inv-card-overlay">
                                <div class="sc-inv-card-title">@item.Name</div>

                                <p class="sc-inv-card-description">
                                    Количество в наличии: <span class="item-count">@item.Count</span> <br />
                                    Цена: <span class="item-price">@item.Price ₽</span>
                                </p>
                            </div>
                        </a>

                    }
                }

                else
                {
                    <p>В настоящее время инвентарь не найден.</p>
                }
            </div>
        </div> 
    </div> 
</div>
<footer>
    <div class="footer-left">
        <h2>FitStock</h2>
        <p>
            Наша система помогает спортивным клубам и секциям эффективно управлять инвентарём и оборудованием.
            Вы сможете легко отслеживать состояние, местоположение и использование всех спортивных принадлежностей,
            планировать выдачу и возврат, а также оптимизировать закупки, экономя время и ресурсы клуба.
        </p>
        <div class="footer-TravelAgency">
            &copy; 2025 FitStock Bancu
        </div>
    </div>

    <div class="contact-grid">

        <!-- 1. Email -->
        <a href="mailto:TTiP@mail.ru" class="contact-card">

            <img class="card-icon" src="~/images/email.png" alt="Email Icon" />
            <h2>Email</h2>
            <p>TTiP@mail.ru</p>
        </a>

        <!-- 2. Телефон -->
        <a href="tel:+37377777777" class="contact-card">
            <img class="card-icon" src="~/images/telefon.png" alt="Phone Icon" />
            <h2>Телефон</h2>
            <p>+ (373) 777-77-777</p>
        </a>

        <!-- 3. Адрес -->
        <div class="contact-card">
            <img class="card-icon" src="~/images/mesto.png" alt="Address Icon" />
            <h2>Адрес</h2>
            <p>Тираспольский техникум информатики и права</p>
        </div>
    </div>

    <!-- НОВЫЙ БЛОК: Социальные сети -->
    <div class="social-media-container">
        <h3>Мы в социальных сетях</h3>
        <div class="social-icons-wrapper">
            <a href="#" target="_blank" class="social-icon">
                <img src="~/images/telegram.png" alt="Telegram Icon" />
            </a>
            <a href="#" target="_blank" class="social-icon">
                <img src="~/images/vk.png" alt="VKontakte Icon" />
            </a>
            <a href="#" target="_blank" class="social-icon">
                <img src="~/images/instagram.png" alt="Instagram Icon" />
            </a>
        </div>
    </div>
</footer>