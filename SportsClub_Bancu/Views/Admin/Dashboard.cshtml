@model SportClub_Bancu.Domain.ViewModels.AdminDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Панель администратора";
}

<link rel="stylesheet" href="~/css/Admin.css" />

<div class="admin-container">

    <header class="admin-header">
        <h1>Панель администратора</h1>
    </header>

    <section class="stats-grid">
        <div class="stat-card">
            <h3>Всего аккаунтов</h3>
            <p class="stat-number">@Model.TotalUsers</p>
        </div>

        <div class="stat-card">
            <h3>Администраторов</h3>
            <p class="stat-number">@Model.TotalAdmins</p>
        </div>

        <div class="stat-card stat-info">
            <h3>Состояние системы</h3>
            <p class="stat-label">Работает стабильно</p>
        </div>
    </section>

    <section class="users-section">
        <h2>Пользователи системы</h2>

        <div class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="avatar-cell">Аватар</th>
                        <th>ID</th>
                        <th>Логин</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.AllUsers)
                    {
                        <tr id="user-row-@user.Id">
                            <td class="avatar-cell">
                                <div class="avatar">
                                    <img src="@(string.IsNullOrEmpty(user.PathImage) ? "/images/default-avatar.png" : user.PathImage)"
                                         alt="User Photo" />
                                </div>
                            </td>

                            <td>@user.Id.ToString().Substring(0, 8)…</td>
                            <td>@user.Login</td>
                            <td>@user.Email</td>

                            <td class="role-text @(user.Role == SportClub_Bancu.Domain.Enum.UserRole.Admin ? "role-admin" : "role-user")">
                                @(user.Role == SportClub_Bancu.Domain.Enum.UserRole.Admin
                                                            ? "Администратор"
                                                            : "Пользователь")
                            </td>

                            <td>
                                @if (user.Email != User.Identity.Name)
                                {
                                    @if (User.IsInRole("Admin"))
                                    {
                                           <button class="btn-delete" onclick="deleteUser('@user.Id')">
                                        Удалить
                                    </button>

                                    }
                                 
                                }
                                else
                                {
                                    <span class="self-label">Это вы</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

<script>
    async function deleteUser(userId) {
        if (!confirm("Вы уверены, что хотите удалить этот аккаунт?")) return;

        const response = await fetch(`/Admin/DeleteUser?id=${userId}`, {
            method: 'POST'
        });

        const result = await response.json();

        if (result.success) {
            document.getElementById(`user-row-${userId}`).remove();
            // Можно обновить цифры статистики через JS при желании
        } else {
            alert("Ошибка: " + result.message);
        }
    }
</script>

<footer>
